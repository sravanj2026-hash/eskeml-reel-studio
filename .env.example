# Background removal and AI backdrops (https://www.photoroom.com/api)
PHOTOROOM_API_KEY=
# AI motion video from a photo (https://dev.runwayml.com)
RUNWAYML_API_SECRET=
# Names, captions and video ideas written by Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: a passcode so only your team can use the paid AI features
STUDIO_PASSCODE=

# ---- Art of Eskeml business system (all free tiers) ----
# Supabase > Project settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=
# Passcode for the owner dashboard at /admin.html (choose a long one)
ADMIN_PASSCODE=
# Your site's address, used in payment links, e.g. https://eskeml-reel-studio.vercel.app
PUBLIC_URL=
# Supabase > Project settings > API: project URL and service_role key (for photo and reel uploads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=catalogue
# Any random text; Vercel sends it to the daily job
CRON_SECRET=
# Meta app (developers.facebook.com): App settings > Basic > App secret, and a verify token you choose
META_APP_SECRET=
META_VERIFY_TOKEN=
# WhatsApp > API setup: permanent access token and phone number ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Instagram > API setup with Instagram login: access token, your Instagram account ID and the Instagram app secret
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
# Optional: your website's address, so its enquiry form can post to /api/enquiry
ENQUIRY_ORIGIN=
